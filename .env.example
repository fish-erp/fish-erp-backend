NODE_ENV=development
PORT=8080
APP_TIMEZONE=Asia/Ho_Chi_Minh
DATABASE_URL=postgresql://USERNAME:PASSWORD@HOST:5432/DATABASE?sslmode=require&schema=fish_erp
JWT_ACCESS_SECRET=replace-with-a-random-access-secret-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-a-different-random-refresh-secret-at-least-32-characters
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800
JWT_ISSUER=fish-erp-api
JWT_AUDIENCE=fish-erp-client
CORS_ORIGINS=http://localhost:3000
SWAGGER_ENABLED=true
LOG_LEVEL=info
